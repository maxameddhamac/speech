# OpenAI powers audio transcription and the OpenAI voice option.
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter powers language-aware summaries and text enhancement.
OPENROUTER_API_KEY=your_openai_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ElevenLabs powers the second generated voice.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: used for OpenRouter app attribution.
NEXT_PUBLIC_APP_URL=http://localhost:3000
